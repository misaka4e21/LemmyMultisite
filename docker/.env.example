# Copy this file to docker/.env and replace the credentials before exposing the stack.
# The defaults below match docker/docker-compose.yml and are only for local development.
S3_ENDPOINT=http://rustfs:9000
S3_BUCKET=lemmy-media
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_USE_PATH_STYLE=true
